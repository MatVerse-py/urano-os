{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scene_id",
    "presentation_id",
    "version",
    "status",
    "source_ref",
    "narration",
    "content",
    "claims",
    "authority",
    "provenance"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "matverse.prancha.scene.v1-demo"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "[a-z0-9][a-z0-9-]{0,99}"
    },
    "presentation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "[a-z0-9][a-z0-9-]{0,99}"
    },
    "version": {
      "type": "string",
      "const": "0.2.0"
    },
    "status": {
      "type": "string",
      "const": "DEMO_ONLY"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "urn:matverse:case:[a-z0-9-]+:fictional-[a-z0-9-]+"
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lang",
        "asset_ref",
        "transcript"
      ],
      "properties": {
        "lang": {
          "type": "string",
          "const": "pt-BR"
        },
        "asset_ref": {
          "type": "null"
        },
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "audience",
        "mode",
        "pet_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "mode": {
          "type": "string",
          "const": "narrative"
        },
        "pet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "[a-z0-9-]+-fictional"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "pattern": "C[0-9]{2,4}"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "type": "string",
            "enum": [
              "HYPOTHESIS",
              "HOLD",
              "DEMO"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_decision_ref",
        "release_receipt_ref",
        "may_execute"
      ],
      "properties": {
        "gate_decision_ref": {
          "type": "null"
        },
        "release_receipt_ref": {
          "type": "null"
        },
        "may_execute": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "review_status",
        "synthetic_data"
      ],
      "properties": {
        "generator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "review_status": {
          "type": "string",
          "const": "HOLD"
        },
        "synthetic_data": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matverse:prancha:scene:v1-demo:schema",
  "title": "Prancha scene v1-demo — contrato 0.2.0",
  "description": "Perfil restrito para o exemplo de cena. Sem execução, autorização ou recibos. Não se aplica ao manifesto legado presentation.v0.1-demo."
}
