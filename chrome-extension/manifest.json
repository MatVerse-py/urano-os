{
  "manifest_version": 3,
  "name": "URANO Publication Bridge",
  "version": "0.1.0",
  "description": "Envia ao URANO apenas o conteúdo da aba que o usuário capturar explicitamente.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Capturar publicação no URANO"
  }
}
